function startForgotPassword(){

var phone=document.getElementById("forgotPhone").value.trim();

if(!phone){
alert("Entre ton numéro de téléphone.");
return;
}

var user=null;

for(var i=0;i<users.length;i++){

if(users[i].phone===phone){
user=users[i];
break;
}

}

if(!user){
alert("Aucun compte trouvé avec ce numéro.");
return;
}

if(!user.securityQuestion||!user.securityAnswer){
alert("Ce compte n'a pas de question de sécurité enregistrée. Crée un nouveau compte ou contacte le support.");
return;
}

var questionLabel=getSecurityQuestionLabel(user.securityQuestion);

var html=

"<h2>❓ Mot de passe oublié</h2>"+

