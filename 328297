break;

}

}

if(contains){
sellerOrders.push(order);
}

}

if(sellerOrders.length===0){

box.innerHTML="<div class='empty'>Aucune commande reçue.</div>";
return;

}

var html="";

for(var k=sellerOrders.length-1;k>=0;k--){

var o=sellerOrders[k];

html+=

"<div class='order-card'>"+

"<strong>"+escapeHTML(o.orderNumber)+"</strong><br>"+

"<p style='margin-top:7px'>"+
escapeHTML(o.customerName)+
"</p>"+

"<p class='small'>"+
escapeHTML(o.customerPhone)+
"</p>"+

"<p class='small'>"+
escapeHTML(o.address)+
"</p>"+

"<p style='margin-top:8px'>"+
Number(o.total).toLocaleString()+
" FCFA</p>"+

"<span class='status'>"+
escapeHTML(getStatusLabel(o.status))+
"</span>"+

(o.paymentStatus?
"<br><span class='status'>"+escapeHTML(getPaymentStatusLabel(o.paymentStatus))+"</span>":"")+

"<button class='main-btn edit' onclick='openOrderStatus("+o.id+")'>"+
"✏️ Modifier le statut"+
"</button>"+

(o.paymentStatus==="en_attente_verification"?
"<button class='main-btn' onclick='verifyPayment("+o.id+")'>✅ Vérifier le paiement</button>":"")+

"</div>";

}

box.innerHTML=html;

}


function getStatusLabel(status){

var labels={

pending:"⏳ En attente",
confirmed:"✅ Confirmée",
preparation:"👨‍🍳 En préparation",
shipping:"🚚 En livraison",
delivered:"📍 Livrée",
cancelled:"❌ Annulée"

};

return labels[status]||status;

}


function getPaymentStatusLabel(status){

var labels={

a_la_livraison:"💵 Paiement à la livraison",
en_attente_verification:"⏳ Paiement Mobile Money en attente de vérification",
paye_confirme:"✅ Paiement Mobile Money confirmé"

};

return labels[status]||"";

}


function verifyPayment(id){

for(var i=0;i<orders.length;i++){

if(Number(orders[i].id)===Number(id)){

orders[i].paymentStatus="paye_confirme";
break;

}

}

save("congo_orders",orders);

showSellerOrders();
showMyOrders();
renderSellerDashboard();

alert("Paiement marqué comme confirmé ✅");

}


function openOrderStatus(id){

var order=null;

for(var i=0;i<orders.length;i++){

if(Number(orders[i].id)===Number(id)){

order=orders[i];
break;

}

}

if(!order)return;

document.getElementById("statusOrderId").value=order.id;
document.getElementById("newOrderStatus").value=order.status;

document.getElementById("orderStatusModal").style.display="block";

}


function saveOrderStatus(){

var id=Number(
document.getElementById("statusOrderId").value
);

var status=document.getElementById("newOrderStatus").value;

for(var i=0;i<orders.length;i++){

if(Number(orders[i].id)===id){

orders[i].status=status;
break;

}

}

save("congo_orders",orders);

closeModal("orderStatusModal");

showSellerOrders();
showMyOrders();
renderSellerDashboard();

alert("Statut mis à jour ✅");

}


