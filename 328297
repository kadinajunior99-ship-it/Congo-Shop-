function renderSellerDashboard(){

var box=document.getElementById("sellerDashboard");

if(!currentUser){
box.innerHTML="";
return;
}

var revenue=0;
var orderCount=0;
var itemsSold=0;
var productRevenue={};

for(var i=0;i<orders.length;i++){

var order=orders[i];

if(order.status==="cancelled")continue;

var sellerItems=[];

for(var j=0;j<order.items.length;j++){

var item=order.items[j];

if(item.sellerId===currentUser.id||item.seller===currentUser.name){
sellerItems.push(item);
}

}

if(sellerItems.length===0)continue;

orderCount++;

for(var k=0;k<sellerItems.length;k++){

var it=sellerItems[k];
var lineTotal=it.price*it.quantity;

revenue+=lineTotal;
itemsSold+=it.quantity;

productRevenue[it.name]=(productRevenue[it.name]||0)+lineTotal;

}

}

var avgOrder=orderCount>0?Math.round(revenue/orderCount):0;

var topProducts=Object.keys(productRevenue).sort(function(a,b){
return productRevenue[b]-productRevenue[a];
}).slice(0,3);

var html=

"<div style='display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:15px'>"+

"<div class='radio-box'><p class='small'>💰 Revenu total</p>"+
"<h3 style='color:#087f3e'>"+revenue.toLocaleString()+" FCFA</h3></div>"+

"<div class='radio-box'><p class='small'>📦 Commandes</p>"+
"<h3 style='color:#087f3e'>"+orderCount+"</h3></div>"+

"<div class='radio-box'><p class='small'>🛍️ Articles vendus</p>"+
"<h3 style='color:#087f3e'>"+itemsSold+"</h3></div>"+

"<div class='radio-box'><p class='small'>📊 Panier moyen</p>"+
"<h3 style='color:#087f3e'>"+avgOrder.toLocaleString()+" FCFA</h3></div>"+

"</div>";

if(topProducts.length>0){

html+="<p class='small' style='margin-bottom:8px'><strong>🏆 Meilleurs produits</strong></p>";

var maxRevenue=productRevenue[topProducts[0]];

for(var p=0;p<topProducts.length;p++){

var name=topProducts[p];
var amount=productRevenue[name];
var pct=maxRevenue>0?Math.round((amount/maxRevenue)*100):0;

html+=

"<div style='margin-bottom:8px'>"+

"<div style='display:flex;justify-content:space-between'>"+
"<span class='small'>"+escapeHTML(name)+"</span>"+
"<span class='small'>"+amount.toLocaleString()+" FCFA</span>"+
"</div>"+

"<div style='background:#eee;border-radius:6px;height:8px;margin-top:3px'>"+
"<div style='background:#087f3e;border-radius:6px;height:8px;width:"+pct+"%'></div>"+
"</div>"+

"</div>";

}

}else{

html+="<div class='empty'>Aucune vente pour le moment.</div>";

}

box.innerHTML=html;

}


function createProduct(){

if(!currentUser){

alert("Connecte-toi d'abord.");
return;

}

if(currentUser.role!=="Vendeur"){

alert("Tu dois devenir vendeur.");
return;

}

var name=document.getElementById("sellerName").value.trim();
var description=document.getElementById("sellerDescription").value.trim();
var price=Number(document.getElementById("sellerPrice").value);
var category=document.getElementById("sellerCategory").value;
var stock=Number(document.getElementById("sellerStock").value);
var imageInput=document.getElementById("sellerImage");

if(!name||!description||!price||!stock){

alert("Remplis tous les champs obligatoires.");
return;

}

var image="";

if(imageInput.files && imageInput.files[0]){

var file=imageInput.files[0];

var reader=new FileReader();

reader.onload=function(e){

finishCreateProduct(
name,
description,
price,
category,
stock,
e.target.result
);

};

reader.readAsDataURL(file);

}else{

finishCreateProduct(
name,
description,
price,
category,
stock,
""
);

}

}


function finishCreateProduct(name,description,price,category,stock,image){

var product={

id:Date.now(),
name:name,
description:description,
price:price,
category:category,
stock:stock,
seller:currentUser.name,
sellerId:currentUser.id,
image:image,
icon:"🛍️"

};

products.push(product);

save("congo_products",products);

document.getElementById("sellerName").value="";
document.getElementById("sellerDescription").value="";
document.getElementById("sellerPrice").value="";
document.getElementById("sellerStock").value="";
document.getElementById("sellerImage").value="";

renderProducts();
showSellerProducts();

alert("Produit publié avec succès 🚀");

}


function showSellerProducts(){

var box=document.getElementById("sellerProducts");

if(!currentUser){

box.innerHTML="";
return;

}

var mine=[];

for(var i=0;i<products.length;i++){

if(
products[i].sellerId===currentUser.id ||
products[i].seller===currentUser.name
){

mine.push(products[i]);

}

}

if(mine.length===0){

box.innerHTML="<div class='empty'>Tu n'as encore aucun produit.</div>";
return;

}

var html="";

for(var j=0;j<mine.length;j++){

var p=mine[j];

html+=

"<div class='order-card'>"+

"<strong>"+escapeHTML(p.name)+"</strong><br>"+

"<span class='small'>"+
Number(p.price).toLocaleString()+
" FCFA · Stock : "+p.stock+
"</span>"+

"<button class='main-btn edit' onclick='editProduct("+p.id+")'>✏️ Modifier</button>"+

"<button class='main-btn danger' onclick='deleteProduct("+p.id+")'>🗑️ Supprimer</button>"+

"</div>";

}

