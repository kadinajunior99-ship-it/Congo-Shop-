function confirmOrder(){

if(cart.length===0){

alert("Ton panier est vide.");
return;

}

var name=document.getElementById("orderName").value.trim();
var phone=document.getElementById("orderPhone").value.trim();
var address=document.getElementById("orderAddress").value.trim();

if(!name||!phone||!address){

alert("Remplis tous les champs.");
return;

}

var payment=document.querySelector(
"input[name='payment']:checked"
).value;

var paymentOperator=null;
var paymentReference=null;
var paymentStatus="a_la_livraison";

if(payment==="mobile"){

paymentOperator=document.getElementById("paymentOperator").value;
paymentReference=document.getElementById("paymentReference").value.trim();

if(!paymentReference){
alert("Indique la référence de ta transaction Mobile Money.");
return;
}

paymentStatus="en_attente_verification";

}

var items=[];
var total=0;

for(var i=0;i<cart.length;i++){

var p=findProduct(cart[i].id);

if(!p)continue;

items.push({

product_id:p.id,
name:p.name,
price:p.price,
quantity:cart[i].quantity,
seller:p.seller,
sellerId:p.sellerId||null

});

total+=p.price*cart[i].quantity;

p.stock-=cart[i].quantity;

}

var order={

id:Date.now(),
orderNumber:"CS-"+Date.now(),
userId:currentUser.id,
customerName:name,
customerPhone:phone,
address:address,
payment:payment,
paymentOperator:paymentOperator,
paymentReference:paymentReference,
paymentStatus:paymentStatus,
items:items,
total:total,
status:"pending",
createdAt:new Date().toISOString()

};

orders.push(order);

save("congo_orders",orders);
save("congo_products",products);

cart=[];

save("congo_cart",cart);

updateCart();
renderProducts();

closeModal("orderModal");

document.getElementById("orderNumber").innerHTML=
"Commande : "+order.orderNumber;

document.getElementById("successModal").style.display="block";

showMyOrders();
showSellerOrders();

}


function showMyOrders(){

var box=document.getElementById("myOrders");

if(!currentUser){

box.innerHTML="";
return;

}

var mine=[];

for(var i=0;i<orders.length;i++){

if(orders[i].userId===currentUser.id){

mine.push(orders[i]);

}

}

if(mine.length===0){

box.innerHTML="<div class='empty'>Aucune commande.</div>";
return;

}

var html="";

for(var j=mine.length-1;j>=0;j--){

