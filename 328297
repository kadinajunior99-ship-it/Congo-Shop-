/* =====================================
   AFFICHAGE PRODUITS
===================================== */

function renderProducts(){

var container=document.getElementById("products");

container.innerHTML="";

for(var i=0;i<products.length;i++){

var p=products[i];

if(p.stock<=0)continue;

var div=document.createElement("div");

div.className="product";
div.setAttribute("data-name",p.name);
div.setAttribute("data-category",p.category);

var image=p.image
? "<img src='"+p.image+"'>"
: p.icon;

div.innerHTML=

"<div class='product-image'>"+image+"</div>"+

"<h3>"+escapeHTML(p.name)+"</h3>"+

"<div class='category'>"+escapeHTML(p.category)+"</div>"+

"<div class='price'>"+
Number(p.price).toLocaleString()+" FCFA"+
"</div>"+

"<p class='small'>Stock : "+p.stock+"</p>"+

"<button onclick='openProduct("+p.id+")'>👀 Voir</button>"+

"<button onclick='addToCart("+p.id+")'>🛒 Ajouter</button>";

container.appendChild(div);

}
}

function escapeHTML(text){

return String(text)
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;");

}


/* =====================================
   RECHERCHE
===================================== */

function searchProducts(){

var text=document.getElementById("search").value.toLowerCase();

var cards=document.querySelectorAll(".product");

for(var i=0;i<cards.length;i++){

var name=cards[i].getAttribute("data-name").toLowerCase();

cards[i].style.display=
name.indexOf(text)!==-1?"block":"none";

}
}


/* =====================================
   FILTRE
===================================== */

function filterProducts(category,button){

var buttons=document.querySelectorAll(".categories button");

for(var i=0;i<buttons.length;i++){
buttons[i].classList.remove("active");
}

button.classList.add("active");

var cards=document.querySelectorAll(".product");

for(var j=0;j<cards.length;j++){

var c=cards[j].getAttribute("data-category");

cards[j].style.display=
(category==="Tous"||c===category)?"block":"none";

}
}


