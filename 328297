function editProduct(id){

var p=findProduct(id);

if(!p)return;

var name=prompt("Nom du produit :",p.name);

if(name===null)return;

var price=prompt("Prix FCFA :",p.price);

if(price===null)return;

var stock=prompt("Stock :",p.stock);

if(stock===null)return;

p.name=name.trim();
p.price=Number(price);
p.stock=Number(stock);

save("congo_products",products);

renderProducts();
showSellerProducts();

alert("Produit modifié ✅");

}


function deleteProduct(id){

var p=findProduct(id);

if(!p)return;

if(!confirm("Supprimer ce produit ?"))return;

for(var i=0;i<products.length;i++){

if(Number(products[i].id)===Number(id)){

products.splice(i,1);
break;

}

}

save("congo_products",products);

renderProducts();
showSellerProducts();

alert("Produit supprimé.");

}


