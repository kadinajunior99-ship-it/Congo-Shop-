html+=

"<div class='order-card'>"+

"<strong>"+escapeHTML(o.orderNumber)+"</strong><br>"+

"<span class='small'>"+
new Date(o.createdAt).toLocaleString()+
"</span>"+

"<p style='margin-top:8px'>"+
Number(o.total).toLocaleString()+
" FCFA</p>"+

"<span class='status'>"+
escapeHTML(getStatusLabel(o.status))+
