(o.paymentStatus?
"<br><span class='status'>"+escapeHTML(getPaymentStatusLabel(o.paymentStatus))+"</span>":"")+

"</div>";

}

box.innerHTML=html;

}


function showSellerOrders(){

var box=document.getElementById("sellerOrders");

if(!currentUser){

box.innerHTML="";
return;

}

var sellerOrders=[];

for(var i=0;i<orders.length;i++){

var order=orders[i];

var contains=false;

for(var j=0;j<order.items.length;j++){

if(
order.items[j].sellerId===currentUser.id ||
order.items[j].seller===currentUser.name
){

