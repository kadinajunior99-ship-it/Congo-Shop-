function registerUser(){

var name=document.getElementById("registerName").value.trim();
var phone=document.getElementById("registerPhone").value.trim();
var password=document.getElementById("registerPassword").value;
var securityQuestion=document.getElementById("registerSecurityQuestion").value;
var securityAnswer=document.getElementById("registerSecurityAnswer").value.trim().toLowerCase();

if(!name||!phone||!password||!securityAnswer){
alert("Remplis tous les champs.");
return;
}

if(password.length<4){
alert("Le mot de passe doit contenir au moins 4 caractères.");
return;
}

for(var i=0;i<users.length;i++){

if(users[i].phone===phone){
alert("Ce numéro possède déjà un compte.");
return;
}

}

var user={
id:Date.now(),
name:name,
phone:phone,
password:password,
securityQuestion:securityQuestion,
securityAnswer:securityAnswer,
