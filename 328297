function updateMobileMoneyInstructions(){

var operator=document.getElementById("paymentOperator").value;
var number=MOBILE_MONEY_NUMBERS[operator];
var operatorName=operator==="airtel"?"Airtel Money":"MTN Mobile Money";

document.getElementById("mobileMoneyInstructions").innerHTML=

"<p class='small'>📲 Envoie le montant total via <strong>"+operatorName+"</strong> au numéro :</p>"+

"<h3 style='color:#087f3e;margin:6px 0'>"+number+"</h3>"+

"<p class='small'>Puis colle ci-dessous la référence reçue par SMS.</p>";

