escapeHTML(p.seller||"Congo Shop")+
"</p>"+

"<button class='main-btn' onclick='addToCart("+p.id+");closeModal(\"productModal\")'>"+
"🛒 Ajouter au panier"+
"</button>";

document.getElementById("productDetails").innerHTML=html;
document.getElementById("productModal").style.display="block";

}


/* =====================================
   PANIER
===================================== */

function addToCart(id){

var p=findProduct(id);

if(!p)return;

if(p.stock<=0){
alert("Ce produit est en rupture de stock.");
return;
}

var found=null;

for(var j=0;j<cart.length;j++){

if(Number(cart[j].id)===Number(id)){
found=cart[j];
break;
}

}

if(found){

if(found.quantity<p.stock){
found.quantity++;
}else{
alert("Stock maximum atteint.");
return;
}

}else{

cart.push({
id:id,
quantity:1
});

}

save("congo_cart",cart);
updateCart();

alert(p.name+" ajouté au panier 🛒");

}


function updateCart(){

var count=0;
var total=0;

for(var i=0;i<cart.length;i++){

var p=findProduct(cart[i].id);

if(p){

if(cart[i].quantity>p.stock){
cart[i].quantity=p.stock;
}

count+=cart[i].quantity;
total+=p.price*cart[i].quantity;

}

}

document.getElementById("cartCount").innerHTML=count;
document.getElementById("cartTotal").innerHTML=total.toLocaleString();
document.getElementById("orderTotal").innerHTML=total.toLocaleString();

save("congo_cart",cart);

showCart();

}


function findProduct(id){

for(var i=0;i<products.length;i++){

if(Number(products[i].id)===Number(id)){
return products[i];
}

}

return null;

}


function showCart(){

var box=document.getElementById("cartItems");

if(cart.length===0){

box.innerHTML="<div class='empty'>Ton panier est vide 🛒</div>";

return;

}

var html="";

for(var i=0;i<cart.length;i++){

var item=cart[i];
var p=findProduct(item.id);

if(!p)continue;

html+=

"<div class='cart-item'>"+

"<div>"+
"<strong>"+escapeHTML(p.name)+"</strong><br>"+
"<span class='small'>"+
Number(p.price).toLocaleString()+
" FCFA</span>"+
"</div>"+

"<div class='qty'>"+

"<button onclick='changeQty("+p.id+",-1)'>−</button>"+

"<strong>"+item.quantity+"</strong>"+

"<button onclick='changeQty("+p.id+",1)'>+</button>"+

"<button onclick='removeCart("+p.id+")'>🗑️</button>"+

"</div>"+

"</div>";

}

box.innerHTML=html;

}


function changeQty(id,value){

for(var i=0;i<cart.length;i++){

if(Number(cart[i].id)===Number(id)){

var p=findProduct(id);

if(!p)break;

cart[i].quantity+=value;

if(cart[i].quantity>p.stock){
cart[i].quantity=p.stock;
}

if(cart[i].quantity<=0){
cart.splice(i,1);
}

break;

}

}

save("congo_cart",cart);
updateCart();

}


function removeCart(id){

for(var i=0;i<cart.length;i++){

if(Number(cart[i].id)===Number(id)){

cart.splice(i,1);
break;

}

}

save("congo_cart",cart);
updateCart();

}


function openCart(){

document.getElementById("cartModal").style.display="block";
showCart();

}


