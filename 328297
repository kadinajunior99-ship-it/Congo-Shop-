}


function resetPassword(){

var phone=document.getElementById("forgotUserPhone").value;
var answer=document.getElementById("forgotAnswer").value.trim().toLowerCase();
var newPassword=document.getElementById("forgotNewPassword").value;

var user=null;

for(var i=0;i<users.length;i++){

if(users[i].phone===phone){
user=users[i];
break;
}

}

if(!user){
alert("Compte introuvable.");
return;
}

if(!answer||answer!==user.securityAnswer){
alert("Réponse incorrecte.");
return;
}

if(!newPassword||newPassword.length<4){
alert("Le mot de passe doit contenir au moins 4 caractères.");
return;
}

user.password=newPassword;

for(var j=0;j<users.length;j++){

if(users[j].phone===phone){
users[j]=user;
break;
}

}

save("congo_users",users);

alert("Mot de passe réinitialisé ✅ Connecte-toi maintenant.");

openAuth("login");

}


